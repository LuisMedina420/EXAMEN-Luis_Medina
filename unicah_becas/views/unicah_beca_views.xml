<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="unicah_beca_view_list" model="ir.ui.view">
        <field name="name">unicah.beca.list</field>
        <field name="model">unicah.beca</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="numero_cuenta" optional="show"/>
                <field name="periodo"/>
                <field name="tipo_beca"/>
                <field name="indice_academico"/>
                <field name="porcentaje_beca"/>
                <field name="monto_descuento" sum="Total ahorro becas"/>
                <field name="pago_neto" sum="Total neto"/>
                <field name="estado" widget="badge"
                       decoration-success="estado == 'aprobada'"
                       decoration-warning="estado == 'borrador'"
                       decoration-danger="estado == 'rechazada'"/>
            </list>
        </field>
    </record>

    <record id="unicah_beca_view_form" model="ir.ui.view">
        <field name="name">unicah.beca.form</field>
        <field name="model">unicah.beca</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_aprobar"
                            string="Aprobar beca"
                            type="object"
                            class="btn-primary"
                            invisible="estado != 'borrador'"/>
                    <button name="action_rechazar"
                            string="Rechazar"
                            type="object"
                            invisible="estado != 'borrador'"/>
                    <field name="estado" widget="statusbar" statusbar_visible="borrador,aprobada,rechazada"/>
                </header>
                <sheet>
                    <group>
                        <group string="Datos del Estudiante y Solicitud">
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="numero_cuenta"/>
                            <field name="carrera"/>
                            <field name="periodo"/>
                        </group>
                        <group string="Evaluación y Cálculo de Beca">
                            <field name="tipo_beca"/>
                            <field name="indice_academico"/>
                            <field name="costo_mensualidad"/>
                            <field name="porcentaje_beca"/>
                            <field name="monto_descuento"/>
                            <field name="pago_neto"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="unicah_beca_view_search" model="ir.ui.view">
        <field name="name">unicah.beca.search</field>
        <field name="model">unicah.beca</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="periodo"/>
                <filter name="becas_aprobadas" string="Aprobadas" domain="[('estado', '=', 'aprobada')]"/>
                <filter name="becas_revision" string="En revisión" domain="[('estado', '=', 'borrador')]"/>
                <filter name="agrupar_tipo" string="Tipo de beca" context="{'group_by': 'tipo_beca'}"/>
                <filter name="agrupar_estado" string="Estado" context="{'group_by': 'estado'}"/>
            </search>
        </field>
    </record>

    <record id="unicah_beca_action" model="ir.actions.act_window">
        <field name="name">Becas Estudiantiles UNICAH</field>
        <field name="res_model">unicah.beca</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="unicah_beca_menu"
              name="Becas UNICAH"
              parent="sale.menu_sale_config"
              action="unicah_beca_action"
              sequence="60"/>
</odoo>
